# Copy this file to .env.local and fill in your values

# OpenRouter API key — get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# SQLite database file path (Prisma format)
DATABASE_URL="file:./prisma/dev.db"

# EmailJS — get your keys at https://emailjs.com
MAIL_SERVICE_ID=
MAIL_TEMPLATE_ID=           # Template: verificación de email (signup)
MAIL_RESET_TEMPLATE_ID=     # Template: restablecer contraseña
MAIL_PUBLIC_KEY=
MAIL_PRIVATE_KEY=
MAIL_COMPANY_NAME=          # Nombre que aparece en los emails (default: LLM Chat)
MAIL_COMPANY_EMAIL=         # Email de contacto que aparece en el footer
